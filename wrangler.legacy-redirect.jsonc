// 旧 URL（https://scrum-guild.ucan-lab.workers.dev）を新しい URL へ送るだけの Worker。
// 本番の Worker の名前を banmen に変えた後、空いた旧名に人が置く（docs/operations.md の「旧 URL の転送」）。
// binding、シークレット、cron を持たない。Workers Builds にはつながず、scripts/deploy-legacy-redirect.ts だけが出す
{
  "name": "scrum-guild",
  "main": "src/legacy-redirect/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // 版ごとのプレビュー URL は作らない
  "preview_urls": false
}
