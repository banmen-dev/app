// 本番の Worker。API（src/server）と、書き出した画面（build/）を1つの Worker で配る。
// デプロイは Cloudflare の Workers Builds だけが行う（docs/development.md の「CD」）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ダッシュボードの Worker の名前と合わせる。名前が workers.dev の URL（PUBLIC_ORIGIN、scripts/deploy.ts の PRODUCTION_URL）を決めるので、
  // 3つは同じ Release で変える（docs/operations.md の「本番の URL を banmen に移す」）
  "name": "banmen",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  // 外へテレメトリを送らない。.claude/settings.json の WRANGLER_SEND_METRICS は Claude のセッションにしか効かないので、
  // 人の手元と Workers Builds でも送らないよう設定に置く
  "send_metrics": false,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 資産の配信に Worker を起動させない
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    // 上書きする。本番はデプロイのスクリプトが Release のタグ（vX.Y.Z。scripts/release-version.ts）を --var で渡し、手元は scripts/dev.ts の --var
    "APP_VERSION": "dev",
    // 0043 と削除済みを除外する版を公開した後、別の Release で true にする。
    "WORKSPACE_DELETE_ENABLED": "false",
    // 公開する URL。更新系の API の Origin の検査に使う。scripts/dev.ts が pnpm dev と pnpm preview の画面の URL に上書きする。
    // Worker の名前か独自ドメインを変えるときに直す（docs/operations.md）
    "PUBLIC_ORIGIN": "https://banmen.ucan-lab.workers.dev"
  },
  // database_id を替えた版を出すと、本番はその D1 に切り替わる。データを写し終える前に出すと、デプロイが空の D1 に
  // 全マイグレーションを当てて空の本番に切り替わり、煙のテストも通る（docs/operations.md の「本番の D1 と R2 を banmen に移す」）。
  // scripts/preview-config.ts の PRODUCTION_DATABASE_ID も同じ ID にする
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "banmen",
      "database_id": "55d9a51f-bb3f-483c-8051-1d867c0f9ce8",
      "migrations_dir": "migrations"
    }
  ],
  // 添付ファイルの中身を置く。手元の dev とテストは R2 を模擬し、本番のバケットには触らない
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "banmen-attachments" }],
  "workers_dev": true,
  // 毎分、期限を過ぎた行を消し、毎時 0 分に、お試しの期限を過ぎた組織を一時停止にする（src/server/scheduled/）
  "triggers": { "crons": ["* * * * *", "0 * * * *"] },
  // 版ごとのプレビュー URL は本番と同じ D1 につながるので作らない
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      // 呼び出しごとのログは URL のパスとクエリを残す。後で OAuth の code や招待の秘密を URL で受けると
      // ログに残るので切り、ログは Worker が出す JSON の1行（src/server/app.ts）だけにする
      "invocation_logs": false
    }
  }
}
