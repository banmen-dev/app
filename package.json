{
  "name": "banmen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "node scripts/prepare.ts && node scripts/git-hooks.ts",
    "dev": "node scripts/prepare.ts && node scripts/dev.ts",
    "dev:open": "node scripts/dev-open.ts",
    "build": "vite build && node scripts/write-headers.ts",
    "sg": "node cli/sg.ts",
    "preview": "pnpm build && node scripts/dev.ts --preview",
    "check": "node scripts/prepare.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/server/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:vitest && pnpm run test:node",
    "test:vitest": "node scripts/prepare.ts && vitest run",
    "test:node": "node --test scripts/*.test.ts && node --test cli/lib/*.test.ts",
    "e2e": "playwright test",
    "screen-review": "node scripts/screen-review.ts",
    "e2e:preflight": "node scripts/e2e-preflight.ts",
    "db:migrate:fresh": "node scripts/migrate-fresh.ts",
    "db:seed": "node scripts/db-seed.ts",
    "bench:loading": "node scripts/loading-bench.ts",
    "bench:boot": "node scripts/boot-bench.ts",
    "bench:backlog": "node scripts/prepare.ts && node scripts/backlog-bench.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "decode-named-character-reference": "^1.3.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.19",
    "js-yaml": "^5.5.0",
    "kysely": "^0.29.9",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-autolink-literal": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.1",
    "mdast-util-gfm-task-list-item": "^2.0.1",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "minimatch": "^11.0.8",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "~5.1.1",
    "wrangler": "^4.162.0"
  }
}
