// GitHub Webhook の受信と、banmen-preview の Builds の起動専用。
{
  "name": "banmen-preview-trigger",
  "main": "src/server/preview-trigger/worker.ts",
  "compatibility_date": "2026-10-01",
  // 外へテレメトリを送らない。.claude/settings.json の WRANGLER_SEND_METRICS は Claude のセッションにしか効かないので、
  // 人の手元と Workers Builds でも送らないよう設定に置く（wrangler.jsonc と同じ）
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "PREVIEW_BUILDS", "class_name": "PreviewBuildGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PreviewBuildGate"] }]
}
